# Copia este archivo como .env y rellénalo. El archivo .env NUNCA se sube a git.

# --- Voz (ElevenLabs) ---------------------------------------------------------
# Tu llave de API de ElevenLabs (elevenlabs.io > Profile > API Keys).
ELEVENLABS_API_KEY=
# ID de la voz. Por defecto "George" (multilingüe). Puedes poner cualquier voz de tu librería.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Cerebro (Claude Code) ----------------------------------------------------
# Comando de Claude Code (déjalo así si "claude" funciona en tu terminal).
CLAUDE_BIN=claude
# Carpeta donde trabaja Jarvis cuando no retomas un chat existente.
# Vacío = tu carpeta personal.
JARVIS_WORKDIR=
# Modelo opcional (vacío = el que use tu Claude Code por defecto).
JARVIS_MODEL=

# Herramientas que Jarvis puede usar SIN preguntarte, separadas por espacios.
# Por defecto SOLO LECTURA. Cualquier herramienta que no esté aquí se rechaza.
#   Read Glob Grep         -> leer y buscar archivos
#   WebSearch WebFetch     -> buscar en internet
#   Bash                   -> ejecutar comandos (control real del computador)
#   Edit Write             -> modificar / crear archivos
#   mcp__<servidor>        -> todas las herramientas de un conector MCP (ej. correo, calendario)
#   mcp__<servidor>__<herramienta> -> solo una herramienta concreta de ese conector
# Mira los nombres de tus conectores con el comando /mcp dentro de "claude".
JARVIS_ALLOWED_TOOLS=Read Glob Grep WebSearch WebFetch

# --- Servidor -----------------------------------------------------------------
PORT=7777
