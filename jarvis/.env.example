# Copia este archivo como .env y rellénalo. El archivo .env NUNCA se sube a git.

# --- Voz ----------------------------------------------------------------------
# Qué voz usar: elevenlabs | piper | browser
# Vacío = automático (ElevenLabs si hay llave, si no Piper si hay modelo, si no la del navegador).
TTS_PROVIDER=

# Piper: voz GRATIS, libre (GitHub) y 100 % local. Instálala con:  pip install piper-tts
# Descarga una voz en español:  python -m piper.download_voices es_MX-ald-medium
# y pon aquí la ruta completa al archivo .onnx descargado.
PIPER_BIN=piper
PIPER_MODEL=

# ElevenLabs (de pago, la más natural)
# Tu llave de API de ElevenLabs (elevenlabs.io > Profile > API Keys).
ELEVENLABS_API_KEY=
# ID de la voz. Por defecto "George" (multilingüe). Puedes poner cualquier voz de tu librería.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Cerebro ------------------------------------------------------------------
# claude = Claude Code (control del PC, tus chats)   |   ollama = IA de código abierto local y gratis
# Puedes cambiarlo también desde la app en cualquier momento.
BRAIN=claude
# Ollama (https://ollama.com). Modelo recomendado en español: qwen2.5:7b (o llama3.1:8b, gemma2:9b).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Oído ---------------------------------------------------------------------
# browser = reconocimiento de Chrome/Edge   |   whisper = Whisper local (código abierto; necesario para la app Android)
STT_PROVIDER=whisper
PYTHON_BIN=python
# Modelo de Whisper: tiny | base | small | medium | large-v3 (más grande = más preciso y más lento)
WHISPER_MODEL=small
# cpu o cuda (si tienes tarjeta NVIDIA)
WHISPER_DEVICE=cpu
WHISPER_LANG=es

# --- Gmail (solo lectura) -----------------------------------------------------
# Cada cuántos minutos revisar correos nuevos para avisarte (0 = nunca).
GMAIL_POLL_MINUTES=5

# --- Acceso desde el celular --------------------------------------------------
# Clave que pide la app. Vacío = se genera sola y se guarda en data/token (se muestra al encender).
JARVIS_TOKEN=

# --- Claude Code --------------------------------------------------------------
# Comando de Claude Code (déjalo así si "claude" funciona en tu terminal).
CLAUDE_BIN=claude
# Carpeta donde trabaja Jarvis cuando no retomas un chat existente.
# Vacío = tu carpeta personal.
JARVIS_WORKDIR=
# Modelo opcional (vacío = el que use tu Claude Code por defecto).
JARVIS_MODEL=

# Herramientas que Jarvis puede usar SIN preguntarte, separadas por espacios.
# Por defecto SOLO LECTURA. Cualquier herramienta que no esté aquí se rechaza.
#   Read Glob Grep         -> leer y buscar archivos
#   WebSearch WebFetch     -> buscar en internet
#   Bash                   -> ejecutar comandos (control real del computador)
#   Edit Write             -> modificar / crear archivos
#   mcp__<servidor>        -> todas las herramientas de un conector MCP (ej. correo, calendario)
#   mcp__<servidor>__<herramienta> -> solo una herramienta concreta de ese conector
# Mira los nombres de tus conectores con el comando /mcp dentro de "claude".
JARVIS_ALLOWED_TOOLS=Read Glob Grep WebSearch WebFetch

# --- Servidor -----------------------------------------------------------------
PORT=7777
