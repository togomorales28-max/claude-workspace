{
  "name": "metalwork-calculator",
  "version": "1.0.0",
  "description": "Metalwork Calculator — cálculo, optimización de cortes y presupuestos para herrería",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
